# Oscar environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Public base URL of the app. Used for metadata and for the email confirmation link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (authentication, database, file storage) ---
# Find these in your Supabase project: Project Settings > API Keys.
# Oscar reads them on the server only and never creates a Supabase client in the browser;
# a test keeps them out of client code. (SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are still
# accepted as older names; set both of a pair, not one of each.)
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Never the secret key: the app
# refuses to start Supabase with a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). NOT used by the application, which runs every request as the
# signed-in user under Row Level Security. Only for trusted operator tooling. Never prefix it
# with NEXT_PUBLIC_, never commit it, and rotate it if it is ever exposed.
# SUPABASE_SECRET_KEY=

# --- Public contact ---
# Shown on /contact and in the legal pages. Leave empty until a real inbox exists.
CONTACT_EMAIL=

# --- Reserved for future phases (leave empty until the phase is implemented) ---
# Database connection string.
# DATABASE_URL=

# AI provider credentials (provider chosen in a later phase).
# AI_PROVIDER_API_KEY=
