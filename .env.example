# Oscar environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Public base URL of the app. Used for metadata and for the email confirmation link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (Supabase Auth) ---
# Server-only. Oscar never creates a Supabase client in the browser.
# Find both in your Supabase project: Project Settings > API.
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=

# --- Public contact ---
# Shown on /contact and in the legal pages. Leave empty until a real inbox exists.
CONTACT_EMAIL=

# --- Reserved for future phases (leave empty until the phase is implemented) ---
# Database connection string.
# DATABASE_URL=

# AI provider credentials (provider chosen in a later phase).
# AI_PROVIDER_API_KEY=
